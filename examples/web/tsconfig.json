{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["../../packages/design-system/src/*"],
      "@package/design-system": [
        "../../packages/design-system/src/index.web.ts"
      ]
    }
  },
  "include": ["src", "vite.config.ts"]
}
